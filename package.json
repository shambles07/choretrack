{
    "name": "choretrack",
    "version": "1.0.0",
    "private": true,
    "description": "A stupid simple, all-in-one family chore tracker. Built by engineers, for engineers.",
    "type": "module",
    "license": "Unlicense",
    "bin": {
        "choretrack": "dist/server/index.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
        "dev:server": "tsx watch server/src/index.ts",
        "dev:web": "vite",
        "build": "npm run build:web && npm run build:server",
        "build:web": "vite build",
        "build:server": "node scripts/build-server.js",
        "start": "node dist/server/index.js",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
        "test": "vitest run",
        "test:e2e": "playwright test --trace off",
        "reset-admin-password": "node dist/server/reset-password.js"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.5",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/static": "^8.3.0",
        "better-sqlite3": "^13.2.0",
        "canvas-confetti": "^1.9.4",
        "fastify": "^5.12.8",
        "framer-motion": "^11.18.2",
        "lucide-react": "^0.460.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^6.30.6",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/better-sqlite3": "^7.6.13",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "changie": "1.26.0",
        "concurrently": "^9.2.5",
        "esbuild": "^0.24.2",
        "tailwindcss": "^4.3.5",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vite": "^6.4.6",
        "vitest": "^2.1.9"
    }
}
